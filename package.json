{
  "name": "peripatos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "verificar:deploy": "node scripts/verificar-deploy.mjs",
    "test:exif": "npx --yes deno@2 test --no-lock --no-check --allow-read --allow-net --allow-env --allow-sys --config supabase/functions/processar-avatar/deno.json supabase/functions/processar-avatar/reencodar.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "exifr": "^7",
    "supabase": "^2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.9.1"
}
