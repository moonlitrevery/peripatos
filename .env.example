# Copie para .env.local e preencha. `supabase status` mostra os valores locais.

# Vão para o navegador (por isso NEXT_PUBLIC_). São públicos por natureza:
# quem protege os dados é o RLS, não o segredo desta chave.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave PÚBLICA das notificações push (VAPID). É pública por natureza: o
# navegador a usa para se inscrever. A chave PRIVADA nunca vem para cá: fica
# só como segredo da Edge Function notificar-mensagem.
# Gere o par com `node scripts/gerar-vapid.mjs`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Só no servidor. NUNCA com prefixo NEXT_PUBLIC_.
# Chave da API do Giphy (https://developers.giphy.com). Sem ela o seletor de
# GIF avisa que está indisponível e o resto do app funciona.
GIPHY_API_KEY=

# A service role do Supabase NÃO é usada pelo app Next.js e não deve existir
# aqui. Só a Edge Function processar-avatar a usa, e ela a recebe do próprio
# Supabase.
